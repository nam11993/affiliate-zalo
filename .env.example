# Server
PORT=3000

# Affiliate ID inferred from the affiliate test link shared in this project.
# Confirm it in Shopee Affiliate before production use.
SHOPEE_AFFILIATE_ID=17345830644

# Optional Shopee Affiliate Open API credentials.
# When present, the app can call productOfferV2 + generateShortLink.
SHOPEE_API_APP_ID=
SHOPEE_API_SECRET=
SHOPEE_API_URL=https://open-api.affiliate.shopee.vn/graphql

# Phase 1 behavior
SHOPEE_OPEN_API_ENABLED=true
SHOPEE_RESOLVE_TIMEOUT_MS=10000
SHOPEE_API_TIMEOUT_MS=12000


# Zalo personal-account listener (UNOFFICIAL zca-js)
# Safe default: read-only. Do not enable replies until you have captured the test Group ID.
ZALO_REPLY_ENABLED=false
ZALO_ALLOWED_GROUP_IDS=
ZALO_LISTEN_DIRECT=false
ZALO_CLASSIFY_SHOPEE_LINKS=true
ZALO_REPLY_COOLDOWN_MS=3000
ZALO_VERBOSE_RAW=false

# Zalo personal-account listener (unofficial)
ZALO_REPLY_ENABLED=false
ZALO_ALLOWED_GROUP_IDS=
ZALO_AUTO_LOCK_FIRST_GROUP=false
ZALO_OPEN_QR_AUTOMATICALLY=true
ZALO_LISTEN_DIRECT=false
ZALO_CLASSIFY_SHOPEE_LINKS=true
ZALO_REPLY_COOLDOWN_MS=3000
ZALO_VERBOSE_RAW=false

# Diagnostics
# IMPORTANT: keep false for normal bot use. Send test messages from another Zalo account.
ZALO_SELF_LISTEN=false
# Prints every incoming message event before filters; useful to diagnose listener issues.
ZALO_DEBUG_EVENTS=true
